
# Firebase Configuration
# Get these from your Firebase Console -> Project Settings -> General -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (server-only, NEVER prefix with NEXT_PUBLIC_)
# Required for checkout, the Stripe webhook, and order fulfillment to write to the
# Realtime Database on behalf of anonymous customers - the Realtime Database security
# rules lock /customers, /orders, and /webhook_events writes to the admin's own account,
# so these server-side flows authenticate as a trusted service account instead.
# Get these from: Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key (downloads a JSON file with these two fields).
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Keep the quotes and the \n sequences exactly as they appear in the downloaded JSON's
# "private_key" field.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Cloudinary Configuration (for image uploads)
# Get these from your Cloudinary Dashboard -> Settings
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
# Client-side upload widget config (admin dashboard's "new product" image upload)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here

# Stripe API Credentials
# Get these from your Stripe Dashboard
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# Stripe Webhook Secret
# Get this from your Stripe Dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Testing Configuration (optional)
WEBHOOK_URL=http://localhost:3000/api/stripe/webhook